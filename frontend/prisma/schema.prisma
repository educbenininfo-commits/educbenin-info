generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  // Nullable: OAuth-only users (e.g. signed up with Google) never set a
  // password. Email/password signup still requires it; the auth route
  // enforces presence at runtime.
  passwordHash      String?
  emailVerifiedAt   DateTime?
  tokenVersion      Int       @default(0)
  withdrawalPinHash String? // bcrypt hash of withdrawal PIN; null = no PIN set
  // Optional display name — populated from OAuth profile on first sign-in.
  // Email/password users can fill it later via /api/auth/me PATCH (future).
  name              String?
  // Optional avatar URL — populated from OAuth profile on first sign-in.
  avatarUrl         String?
  // App-wide role. USER is the default; ADMIN unlocks /admin back-office;
  // SUPERADMIN can promote/demote other admins. Bootstrap an initial
  // SUPERADMIN via `pnpm db:make-superadmin <email>` (see scripts).
  role              String    @default("USER") // USER | ADMIN | SUPERADMIN
  // Account status. ACTIVE = login + refresh allowed; SUSPENDED = both
  // refused with 403 ACCOUNT_SUSPENDED. Mutated via /api/admin/users/[id]/status
  // (ADMIN can suspend; only SUPERADMIN can restore).
  status            String    @default("ACTIVE") // ACTIVE | SUSPENDED
  // Cosmetic-only sub-label for an ADMIN row (never read for access control —
  // SUPERADMIN/ADMIN rank alone still gates everything via requireAdmin).
  // Lets the back-office show "Administrateur" vs "Support" for two ADMIN-rank
  // members with different default module permissions. Null for USER/SUPERADMIN.
  adminLabel        String? // ADMIN | SUPPORT
  // Per-module permission grid for the Comptes admin & rôles screen. Only
  // consulted for role=ADMIN (a SUPERADMIN always has full access regardless
  // of this field's contents) via requireModulePermission(). Shape:
  // { dossiers, dossiersRejetes, specialites, tarifs, comptesAdmin }, each
  // "manage" | "read" | "none".
  modulePermissions Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  verificationCodes VerificationCode[]
  uploads           FileUpload[]
  notifications     Notification[]
  notifPrefs        NotificationPreferences?
  orders            Order[]
  withdrawals       Withdrawal[]
  oauthAccounts     OAuthAccount[]
  adminActions      AdminAction[]
  invitesSent       AdminInvite[]
  tarifBaremes      TarifBareme[]

  // Multi-tenancy is opt-in per project: by default no resource is org-scoped.
  // Apps that need it (marketplace, B2B SaaS, classifieds) wire owner relations
  // on their domain models.
  ownedOrganizations Organization[]       @relation("OrgOwner")
  memberships        OrganizationMember[] @relation("OrgMembership")
  sessions           Session[]
  pushSubscriptions  PushSubscription[]

  @@index([email])
  @@index([role])
  @@index([status])
}

// ───────────────────────────────────────────────────────────────────────
// Sessions — one row per logical login (device/browser), spanning every
// refresh-token rotation until revoked or naturally expired. `id` is the
// stable `sid` claim embedded in both the access and refresh JWTs (see
// lib/server/auth/sessions.ts) — this is what lets refresh reject a
// specific revoked session instead of the all-or-nothing tokenVersion bump.
// Created at login/verify-email/OAuth callback; touched (lastSeenAt) on
// every refresh; revoked on logout or an explicit "Déconnecter" click in
// Paramètres → Sessions actives.
model Session {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  userAgent String? // raw header, kept for debugging; `device` below is the parsed display label
  device    String? // e.g. "Windows · Chrome" — see parseDeviceLabel()
  ip        String?
  location  String? // e.g. "Cotonou, Bénin" — resolved once at creation, best-effort (never blocks login)

  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?

  @@index([userId])
}

// ───────────────────────────────────────────────────────────────────────
// Web Push subscriptions — one row per browser/device an admin subscribed
// from (usually while running the installed PWA, see
// components/pwa/PushSetup.tsx). `endpoint` is unique per push service
// registration; `p256dh`/`auth` are the subscription's encryption keys,
// required by the Web Push protocol (see lib/server/push/send.ts). A
// subscription that a push service reports as gone (404/410) is deleted
// rather than retried.
model PushSubscription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  endpoint  String  @unique
  p256dh    String
  auth      String
  userAgent String?

  createdAt DateTime @default(now())

  @@index([userId])
}

// ───────────────────────────────────────────────────────────────────────
// Admin audit log — every back-office mutation is recorded here so we can
// answer "who did what when" during incidents / compliance reviews.
//
// `action` is a free-form dotted string the UI groups by (e.g.
// "withdrawal.cancel", "user.role_change", "order.refund").
// `targetType` + `targetId` reference the affected row when applicable.
// `metadata` carries the diff or extra context as JSON.
//
// Retention: not pruned automatically (compliance). If your jurisdiction
// requires deletion after N years, add a cron in backend/src/index.ts
// modeled on the WebhookLog purge.
// ───────────────────────────────────────────────────────────────────────
model AdminAction {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
}

// ───────────────────────────────────────────────────────────────────────
// Admin invitations — Comptes admin & rôles screen.
//
// A single row per invitation attempt. No `User` is created at send time —
// only at confirmation (POST /api/admin/invites/[token]/confirm) — so that a
// Gmail invitee cannot silently log in via "Sign in with Google" (which links
// by email with no other check) before actually clicking the confirmation
// link. `token` is opaque (randomBytes(32).base64url, same pattern as
// Dossier.authToken) and expires 10 minutes after creation, never extended.
model AdminInvite {
  id                String    @id @default(cuid())
  email             String
  name              String? // display name for the invitee (e.g. "Administration",
  // a shared team mailbox rather than a person) — applied to User.name at confirmation
  role              String // ADMIN | SUPERADMIN — applied to the User row at confirmation
  adminLabel        String? // ADMIN | SUPPORT — cosmetic, see User.adminLabel
  modulePermissions Json?
  invitedByUserId   String
  invitedBy         User      @relation(fields: [invitedByUserId], references: [id], onDelete: Restrict)
  token             String    @unique
  expiresAt         DateTime
  consumedAt        DateTime?
  revokedAt         DateTime?
  createdAt         DateTime  @default(now())

  @@index([email])
  @@index([token])
}

// ───────────────────────────────────────────────────────────────────────
// Multi-tenancy primitives — opt-in.
//
// Default project surface stays user-owned (`Order.userId`, `Withdrawal.userId`).
// Apps that need orgs add `organizationId String?` to their domain models
// case by case and use `requireOrgRole()` middleware to gate access.
//
// Slug must be unique app-wide (not just within an owner) so it can be
// used as a stable URL segment.
// ───────────────────────────────────────────────────────────────────────
model Organization {
  id        String               @id @default(cuid())
  slug      String               @unique
  name      String
  ownerId   String
  owner     User                 @relation("OrgOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members   OrganizationMember[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([ownerId])
}

// Role precedence: OWNER > ADMIN > MEMBER. The owner is also a member row
// (created in the same tx as the org) so list-my-orgs queries can join
// uniformly via memberships.
model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("OrgMembership", fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("MEMBER") // OWNER | ADMIN | MEMBER
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
  @@index([userId])
}

// ───────────────────────────────────────────────────────────────────────
// OAuth identities — one User can have N linked providers (Google, GitHub, …).
// (provider, providerAccountId) is unique so the same Google account can't
// link twice. Email matching at sign-in is intentional: if a user signed up
// with email/password and later "Sign in with Google" using the same email,
// we link the Google account to the existing user instead of creating a
// duplicate (see backend/src/routes/oauth.ts).
// ───────────────────────────────────────────────────────────────────────
model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String // "google" | "github" | …
  providerAccountId String // sub from the OIDC ID token
  // Optional refresh token (encrypted at rest if you store one) — Google
  // only returns it on first consent with `access_type=offline`. Most
  // boilerplate flows don't need it; we keep the column for future use.
  refreshToken      String?
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model VerificationCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  type      String // EMAIL_VERIFY | PASSWORD_RESET
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([userId, type])
  @@index([code, type])
}

// ───────────────────────────────────────────────────────────────────────
// File uploads — Cloudinary (column names kept from the R2 era; no migration needed)
// ───────────────────────────────────────────────────────────────────────
model FileUpload {
  id        String   @id @default(cuid())
  userId    String? // nullable — uploads can be anonymous if route allows
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  key       String   @unique // Cloudinary public_id (column name historical — was R2 object key)
  filename  String
  mimeType  String
  sizeBytes Int
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 2 — durable email queue rows
// ───────────────────────────────────────────────────────────────────────
model EmailJob {
  id          String    @id @default(cuid())
  to          String
  subject     String
  html        String
  text        String?
  status      String    @default("PENDING") // PENDING | SENT | FAILED | DEAD
  attempts    Int       @default(0)
  lastError   String?
  scheduledAt DateTime  @default(now())
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, scheduledAt])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 2 — notifications (at-most-once via dedupeKey)
// ───────────────────────────────────────────────────────────────────────
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  data      Json?
  dedupeKey String    @unique
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model NotificationPreferences {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // JSON map of { eventType: { email: bool, inApp: bool } } — flexible without migrations.
  prefs     Json     @default("{}")
  updatedAt DateTime @updatedAt
}

// ───────────────────────────────────────────────────────────────────────
// Outbox — durable side-effects (notifications, emails) emitted from
// inside transactions (e.g. webhook handlers, withdrawal flow). Side-effect
// rows are inserted in the same tx as the state change, then a worker
// drains them. Survives crashes the previous postCommit-callback pattern
// silently dropped.
//
// `kind` is a free-form string the dispatcher routes on
// (e.g. "notification.payment_received", "email.payment_confirmation").
// ───────────────────────────────────────────────────────────────────────
model OutboxEvent {
  id          String    @id @default(cuid())
  kind        String
  payload     Json
  status      String    @default("PENDING") // PENDING | SENT | FAILED | DEAD
  attempts    Int       @default(0)
  lastError   String?
  scheduledAt DateTime  @default(now())
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, scheduledAt])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 2 — webhook idempotency log
// ───────────────────────────────────────────────────────────────────────
model WebhookLog {
  id          String    @id @default(cuid())
  provider    String
  externalId  String
  eventType   String
  payload     Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([externalId, eventType])
  @@index([provider, createdAt])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 3 — payments (Order + Withdrawal)
//
// `amount` is stored in the smallest unit of `currency` (no decimals).
// For XOF (FCFA, Senegal) that's 1 = 1 FCFA. For USD adapt to cents
// at the call site — the schema is currency-agnostic.
// ───────────────────────────────────────────────────────────────────────
model Order {
  id            String  @id @default(cuid())
  userId        String? // nullable — guest checkout supported
  user          User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  amount        Int // gross amount, smallest unit
  currency      String  @default("XOF") // ISO 4217
  status        String  @default("PENDING") // PENDING | PAID | EXPIRED | FAILED | REFUNDED
  customerEmail String?
  customerPhone String?
  customerName  String?
  metadata      Json? // app-specific fields

  // Stripe-grade idempotency. Required header on POST /api/orders; replay
  // with same value returns the original Order row instead of double-charging.
  // Nullable so existing rows pre-migration don't break the @unique constraint.
  idempotencyKey String? @unique

  // Provider reference
  provider         String // e.g. "bictorys"
  providerChargeId String? @unique
  paymentUrl       String? // checkout/redirect URL returned by provider
  paymentMethod    String? // WAVE | ORANGE_MONEY | FREE_MONEY (set on PAID by webhook)

  // Optional commission (for marketplace-style apps)
  commissionAmount Int?
  netAmount        Int?

  // Lifecycle
  expiresAt DateTime // PENDING expiry; not cleared on PAID (history)
  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([status, expiresAt])
  @@index([provider, providerChargeId])
}

model Withdrawal {
  id          String @id @default(cuid())
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  amount      Int // requested amount, smallest unit
  currency    String @default("XOF")
  status      String @default("PENDING") // PENDING | PROCESSING | COMPLETED | FAILED | CANCELLED
  destination Json // { method: "WAVE" | "ORANGE_MONEY" | ..., phone: "+221...", accountName?: "..." }

  // Provider reference
  provider         String // e.g. "bictorys"
  providerPayoutId String? @unique
  failureReason    String?

  requestedAt DateTime  @default(now())
  processedAt DateTime?
  completedAt DateTime?

  @@index([userId, requestedAt])
  @@index([status, requestedAt])
  @@index([provider, providerPayoutId])
}

model Dossier {
  id        String @id @default(cuid())
  reference String @unique // "EB-202609-001" — see frontend/src/lib/server/dossiers/reference.ts

  nom         String
  prenom      String
  whatsapp    String // E.164, e.g. "+22997000000" — see components/forms/CountryPhoneInput.tsx
  nationalite String? // ISO2 country code, e.g. "BJ" — see lib/countries.ts

  // Multi-school scope (2026-09) — every Dossier belongs to exactly one
  // Ecole and one Categorie (both required; onDelete: Restrict so a
  // reference row can never be removed out from under existing dossiers).
  // See the Ecole/Categorie/Filiere doc comment below for the full model.
  ecoleId     String
  ecole       Ecole     @relation(fields: [ecoleId], references: [id], onDelete: Restrict)
  categorieId String
  categorie   Categorie @relation(fields: [categorieId], references: [id], onDelete: Restrict)

  // Single-filière selector — used for every Categorie EXCEPT FSS's
  // "Probatoire spécialité (D.E.S.)", which keeps using specialtyCodes
  // below (legacy multi-select). Nullable: left unset for D.E.S. dossiers.
  filiereId String?
  filiere   Filiere? @relation(fields: [filiereId], references: [id], onDelete: Restrict)

  // Legacy multi-select, FSS "Probatoire spécialité (D.E.S.)" ONLY — a
  // candidate may apply to several specialties in one dossier. Codes from
  // frontend/src/lib/specialties.ts, now mirrored 1:1 by Filiere.code rows
  // under the D.E.S. Categorie (see generateReference/seed-schools.ts).
  // Left as an empty array for every other Categorie, which use filiereId
  // above instead.
  specialtyCodes String[] // codes from frontend/src/lib/specialties.ts, e.g. ["ANR","CAR"]
  stage          Int      @default(1) // 0=rejeté, 1..5 — see STAGE_NAMES in frontend/src/lib/dossiers-data.ts

  pieceJointeUrl String? // initial dossier PDF — Supabase Storage path (private bucket), not a URL despite the field name; signed URLs are minted on read (see lib/server/upload/supabase-storage-client.ts)

  authToken          String?   @unique // random, generated on "Envoyer"/"Renvoyer" — never the reference itself
  authTokenExpiresAt DateTime?
  authSentAt         DateTime?
  authSubmittedAt    DateTime? // set when the candidate submits /authentification-diplome/[token]; cleared back to null on a resend so the state machine treats the resubmission as pending again
  authFormData       Json? // same shape as the existing frontend `AuthForm` type — kept across a resend so the candidate's re-visit can be pre-filled

  // Diploma uploads — one field per document. Was a single combined
  // Bac+Doctorat PDF (`diplomaUrl`); split back into separate required
  // uploads per product decision, plus two conditional translated
  // versions when the checkbox "diplôme non francophone" is ticked.
  diplomaBacUrl                String? // storage path, see pieceJointeUrl note above
  diplomaDoctoratUrl           String?
  diplomaBacTranslatedUrl      String?
  diplomaDoctoratTranslatedUrl String?

  // Correction workflow — an admin can resend whichever form matches the
  // dossier's current stage (Demande at stage 1, Authentification at
  // stage 2), pre-filled with the data already on file. Non-null while a
  // correction is outstanding; the "Dossier MAJ" pill in the back-office
  // list reads this. Cleared back to null once the candidate resubmits.
  correctionRequestedAt    DateTime?
  correctionToken          String?   @unique // stage-1 (Demande) correction link only — stage-2 reuses authToken
  correctionTokenExpiresAt DateTime?

  ficheUploaded Boolean @default(false)
  ficheUrl      String? // storage path, see pieceJointeUrl note above

  recepisseUploaded Boolean @default(false)
  recepisseUrl      String? // storage path, see pieceJointeUrl note above

  montant           Int    @default(50000)
  montantSupplement Int? // multi-spécialités, staff-editable, may stay empty
  paye              Int    @default(0)
  moyen             String @default("Non renseigné") // Non renseigné | Mobile Money | Espèces | Virement

  motifRejet String?

  stageChangedAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  comments DossierComment[]

  @@index([stage])
  @@index([whatsapp])
  @@index([ecoleId])
  @@index([categorieId])
  @@index([filiereId])
}

model DossierComment {
  id        String  @id @default(cuid())
  dossierId String
  dossier   Dossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  type       String // "public" | "internal"
  text       String
  authorName String // admin's email, from requireAdmin's session

  createdAt DateTime @default(now())

  @@index([dossierId])
}

// ───────────────────────────────────────────────────────────────────────
// Multi-school scope (2026-09) — Ecole > Categorie > Filiere.
//
// An Ecole (school, e.g. "FSS", "INMeS") has N Categories (e.g. "Master",
// "Probatoire spécialité (D.E.S.)"). A Categorie has a `typeAdmission`:
//
//   - "dossier": no concours/composition — the candidate submits a Dossier,
//     the school studies it, response is accept/reject. NEVER has a
//     date/heure/salle on any of its Filiere rows — the candidate flow and
//     every screen must never ask for or show one for this kind of Categorie.
//   - "concours_ou_composition": every Filiere under it has a
//     date/heure/salle (composition date, not per-Categorie) — e.g. FSS's
//     "Probatoire spécialité (D.E.S.)" (each Filiere IS one of the 27
//     legacy specialties from lib/specialties.ts) and INMeS's "Cycle I"
//     (a single Filiere, one composition date). Every screen showing a
//     Filiere of this kind must show its date/heure/salle.
//
// INMeS Cycle I special case: it keeps typeAdmission="concours_ou_composition"
// (a real composition date exists and must be shown, for information), but
// the app does NOT accompany that national entrance exam — it's reserved
// to state-scholarship national candidates and happens BEFORE the dossier
// phase. What the app accompanies for INMeS Cycle I is the dossier
// submission that follows (studied by INMeS, accept/reject response). Any
// screen about INMeS Cycle I must show both facts together — the
// composition date (informational) AND the dossier-submission
// accompaniment (the actual product) — never one without the other.
//
// Seed data (2 schools, 5 categories, ~49 filières incl. the 27 legacy
// D.E.S. specialties) lives in frontend/scripts/seed-schools.ts — run once
// against the shared dev/prod DB, not gated by NODE_ENV like seed-dev.ts,
// since this is real launch reference data, not throwaway dev fixtures.
// ───────────────────────────────────────────────────────────────────────
model Ecole {
  id                  String  @id @default(cuid())
  nom                 String // e.g. "FSS", "INMeS"
  description         String?
  lienWhatsappGeneral String?

  categories Categorie[]
  dossiers   Dossier[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Categorie {
  id      String @id @default(cuid())
  ecoleId String
  ecole   Ecole  @relation(fields: [ecoleId], references: [id], onDelete: Restrict)

  libelle       String // e.g. "Médecine, Pharmacie & filières de base (Licence)", "Probatoire spécialité (D.E.S.)"
  // Short form for the "École · Catégorie" badge used on Dossiers (10),
  // École & WhatsApp (11) and Tarifs (13) — e.g. "Médecine & Pharmacie",
  // "D.E.S.", "Master". Falls back to the full `libelle` if unset (a new
  // Categorie without one yet still displays something reasonable).
  libelleCourt  String?
  // "dossier" | "concours_ou_composition" — see Ecole doc comment above.
  typeAdmission String

  // Curated body text shown on every card/section referencing this
  // Categorie (École pages, Accompagnement hub, demand-form info callouts)
  // — kept in the data model rather than hardcoded per screen so a
  // back-office edit (prompt 11/13) propagates everywhere at once. One
  // field serves both the École page's longer card copy and the
  // Accompagnement hub's card copy — the reference mockups show slightly
  // shorter copy on the hub for some categories; this is a deliberate
  // simplification (one source of truth over near-duplicate text).
  description String?

  // Starting price shown as "À partir de X FCFA" on every public page that
  // lists this Categorie (Accompagnement hub, École pages, demand-form
  // screens) — smallest currency unit, no decimals, same convention as
  // Order.amount/Dossier.montant. The single source of truth for pricing
  // ("aucun montant ne doit être codé en dur", CLAUDE.md "Extension
  // multi-écoles") — the back-office Tarifs screen (prompt
  // 13-backoffice-tarifs-personnalisables.md) is expected to expose an
  // editing UI for this field; nothing here builds that UI yet.
  tarifDepart Int?

  // "Pièces à fournir" list shown on this Categorie's demand-form page
  // (fss/des, fss/licence, fss/medecine-pharmacie, fss/master,
  // inmes/cycle-1, inmes/cycle-2) — a plain string array (each entry one
  // line item), stored in the data model instead of hardcoded per page so
  // a back-office edit (École & WhatsApp screen) propagates everywhere at
  // once. Deliberately plain strings, not rich JSX — anything that needs
  // bold/emphasis in the original mockup copy is flattened to plain text
  // (e.g. "Quittance CUCA de 20 000 FCFA (...)") since admin-editable
  // content can't practically carry arbitrary inline markup.
  piecesAFournir Json?
  // Small italic legend under the "Pièces à fournir" heading, e.g.
  // "d'après le communiqué N°725/UAC/FSS du 8 avril 2026". Null when a
  // category has none (e.g. D.E.S.).
  piecesLegend String?

  filieres Filiere[]
  dossiers Dossier[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ecoleId])
}

model Filiere {
  id          String    @id @default(cuid())
  categorieId String
  categorie   Categorie @relation(fields: [categorieId], references: [id], onDelete: Restrict)

  nom String

  // Legacy 3-letter code for the FSS D.E.S. specialties (matches
  // Dossier.specialtyCodes entries and frontend/src/lib/specialties.ts,
  // e.g. "ANR", "CAR") — null for every other Filiere.
  code String?

  // Populated ONLY when categorie.typeAdmission = "concours_ou_composition"
  // (see Ecole doc comment above). Always null for a "dossier" Categorie.
  date  String?
  heure String?
  salle String?

  lienWhatsapp String?

  dossiers Dossier[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categorieId])
  @@index([code])
}

// ───────────────────────────────────────────────────────────────────────
// Suggestions — public visitors proposing a missing school/filière (site
// copy always says "Suggérer" / "Suggestions", never "Signaler" /
// "Signalements" — see CLAUDE.md "Extension multi-écoles").
// ───────────────────────────────────────────────────────────────────────
model Suggestion {
  id        String   @id @default(cuid())
  nom       String // visitor's name
  contact   String // WhatsApp number or e-mail
  recherche String // free text — school/filière they were looking for
  message   String?
  statut    String   @default("nouveau") // nouveau | vu | a_ajouter | refuse
  createdAt DateTime @default(now())

  @@index([statut, createdAt])
}

// ───────────────────────────────────────────────────────────────────────
// Tarifs — back-office pricing module (13-backoffice-tarifs-personnalisables.md).
// Append-only history: every save creates a NEW row rather than mutating
// the previous one, so "Historique des barèmes" is just this table ordered
// by `effectiveFrom` desc — the most recent row is the "Actif" one (no
// separate status column, derived at read time), every earlier row reads
// as "Archivé".
//
// This table is the audit trail; `Categorie.tarifDepart` stays the fast,
// already-wired read path every public page queries directly (École
// pages, Accompagnement hub, demand-form screens) — saving a new barème
// writes both: a TarifBareme history row AND the matching
// Categorie.tarifDepart value(s), in the same transaction.
model TarifBareme {
  id   String @id @default(cuid())
  mode String // "personnalise" | "unique"

  // mode="personnalise": { [categorieId]: montant } for every Categorie at
  // save time. mode="unique": null (montantUnique below holds the value).
  montants      Json?
  // mode="unique" only — the single amount applied to every Categorie.
  montantUnique Int?

  // Free text, e.g. "+ 25 000 FCFA / spécialité supplémentaire" — D.E.S. only.
  regleSpecialitesAdditionnelles String?

  effectiveFrom   DateTime @default(now())
  createdByUserId String
  createdBy       User     @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt       DateTime @default(now())

  @@index([effectiveFrom])
}
